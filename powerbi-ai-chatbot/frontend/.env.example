# Frontend configuration (Vite). Only NON-SECRET values belong here — these are
# compiled into the browser bundle. NEVER put a client secret or API key here
# (NFR §3, Phase 3).

# Backend API base URL. Leave as /api to use the dev proxy (vite.config.ts).
VITE_API_BASE_URL=/api

# Microsoft Entra ID (public SPA values — safe in the browser).
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
# The backend API scope the SPA requests a token for, e.g.
# api://powerbi-ai-chatbot/access_as_user
VITE_ENTRA_API_SCOPE=

# Redirect URI registered in the Entra app (defaults to window origin).
VITE_ENTRA_REDIRECT_URI=

# When true, the app skips MSAL and uses a mock bearer token so the UI runs
# against a backend in MOCK_MODE with no Entra tenant. Never enable in prod.
VITE_MOCK_AUTH=true
