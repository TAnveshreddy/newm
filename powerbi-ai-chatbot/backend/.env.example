# ---------------------------------------------------------------------------
# Backend configuration. Copy to .env for local dev. NEVER commit real secrets.
# Non-secret values may be set as App Service application settings; secret
# values should come from Key Vault references (Phase 12).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8080

# When true, Azure OpenAI / Power BI / Entra token validation use in-process
# mocks so the app runs with no secrets. MUST be false in production.
MOCK_MODE=true

# Comma-separated allowed frontend origins (CORS).
ALLOWED_ORIGINS=http://localhost:5173

# --- Entra ID (non-secret) ---
ENTRA_TENANT_ID=
# The API app's own Application (client) ID — the accepted token audience.
ENTRA_API_AUDIENCE=
# Optional overrides (derived from tenant id when omitted):
# ENTRA_ISSUER=
# ENTRA_JWKS_URI=

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-06-01
# Prefer managed identity; only set a key if the chosen auth method requires it (SECRET).
AZURE_OPENAI_API_KEY=

# --- Power BI (non-secret identifiers) ---
POWERBI_WORKSPACE_ID=
POWERBI_API_BASE_URL=https://api.powerbi.com/v1.0/myorg

# --- Limits / safety ---
MAX_ROWS=1000
QUERY_TIMEOUT_MS=30000
CHAT_RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BODY_BYTES=65536
