        }
      ],
      "measures": [
        {
          "name": "Total Revenue",
          "expression": "SUM(Sales[Net Sales])",
          "formatString": "#,0.00",
          "definition": "Sum of Net Sales (gross sales after discounts)."
        },
        {
          "name": "Total Profit",
          "expression": "SUM(Sales[Profit])",
          "formatString": "#,0.00",
          "definition": "Sum of Profit (Net Sales minus Total Cost)."
        },
        {
          "name": "Total Orders",
          "expression": "COUNTROWS(Sales)",
          "formatString": "#,0",
          "definition": ""
        },
        {
          "name": "Total Returns",
          "expression": "CALCULATE(COUNTROWS(Sales), Sales[Order Status]=\"Returned\")",
          "formatString": "#,0",
          "definition": ""
        },
        {
          "name": "Total Customers",
          "expression": "DISTINCTCOUNT(Sales[Customer ID])",
          "formatString": "#,0",
          "definition": ""
        },
        {
          "name": "Avg Order Value",
          "expression": "DIVIDE([Total Revenue], [Total Orders], 0)",
          "formatString": "#,0.00",
          "definition": "Total Revenue divided by number of orders."
        },
        {
          "name": "Profit Margin %",
          "expression": "DIVIDE([Total Profit], [Total Revenue], 0)",
          "formatString": "0.00%",
          "definition": "Total Profit divided by Total Revenue."
        },
        {
          "name": "Return Rate %",
          "expression": "DIVIDE([Total Returns], [Total Orders], 0)",
          "formatString": "0.00%",
          "definition": "Returned orders as a share of all orders."
        },
        {
          "name": "Revenue YoY %",
          "expression": "VAR cy = CALCULATE([Total Revenue], YEAR(Sales[Order Date]) = YEAR(TODAY()))\nVAR py = CALCULATE([Total Revenue], YEAR(Sales[Order Date]) = YEAR(TODAY())-1)\nRETURN DIVIDE(cy - py, py, 0)",
          "formatString": "0.00%",
          "definition": "Year-over-year growth of Total Revenue vs the same period last year."
        },
        {
          "name": "Completed Orders",
          "expression": "CALCULATE(COUNTROWS(Sales), Sales[Order Status]=\"Completed\")",
          "formatString": "#,0",
          "definition": ""
        },
        {
          "name": "Pending Orders",
          "expression": "CALCULATE(COUNTROWS(Sales), Sales[Order Status]=\"Pending\")",
          "formatString": "#,0",
          "definition": ""
        },
        {
          "name": "Total Gross Sales",
          "expression": "SUM(Sales[Gross Sales])",
          "formatString": "#,0.00",
          "definition": ""
        },
        {
          "name": "Total Discount",
          "expression": "SUM(Sales[Discount Amount])",
          "formatString": "#,0.00",
          "definition": ""
        }
      ],
      "rowCount": 500,
